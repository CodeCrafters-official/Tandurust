# ============ TANDURUST BACKEND CONFIGURATION ============

# NeonDB PostgreSQL (Production)
# Sign up at https://neon.tech and create a database called "tandurust"
# Copy your connection string below:
DATABASE_URL=postgresql://tandurust_owner:YOUR_PASSWORD@ep-YOUR-ENDPOINT.us-east-2.aws.neon.tech/tandurust?sslmode=require

# For local development without NeonDB:
# DATABASE_URL=sqlite:///tandurust.db

# Secret key for session management
SECRET_KEY=tandurust-sih-2026-secret-key

# OpenRouter API Key (for AI features - chatbot, first aid, health tips)
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
